{
  "manifest_version": 3,
  "name": "YT Metadata Pro",
  "version": "2.1.0",
  "description": "Badges YouTube results that YouTube has identified as a registered musical work.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "identify.js",
        "content.js"
      ],
      "css": [
        "badge.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
